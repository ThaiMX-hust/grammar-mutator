{
  "rules": {
    "<start>": "<wrapper>",
    "<wrapper>": "<wrapper_choice>",
    "<payload>": "<payload_choice>",
    "<sigma_payload>": "<obf_chcp> <noise> <obf_codepage>",
    "<mitre_payload>": "<mitre_choice>",
    "<noise>": "<noise_choice>"
  },
  "weights": {
    "<wrapper_choice>": {
      "cmd.exe /c <payload>": 1.0,
      "cmd.exe /r <payload>": 1.0,
      "echo <payload> | cmd": 1.0,
      "%COMSPEC% /c <payload>": 1.0,
      "cmd < <payload>": 1.0
    },
    "<payload_choice>": {
      "<sigma_payload>": 0.6,
      "<mitre_payload>": 0.4
    },
    "<obf_chcp>": {
      "chcp": 1.0,
      "\"chcp\"": 1.0,
      "CHCP": 1.0,
      "c^hcp": 1.0,
      "ch\"\"cp": 1.0,
      "\"ch\"&\"cp\"": 1.0,
      "chcp.com": 1.0,
      "\"chcp.com\"": 1.0,
      "c^hcp.com": 1.0,
      "%SystemRoot%\\System32\\chcp.com": 1.0
    },
    "<obf_codepage>": {
      "936": 1.0,
      "1258": 1.0,
      "\"936\"": 1.0,
      "9^36": 1.0,
      "936 >nul": 1.0,
      "1258 2>nul": 1.0,
      "936 & REM evasion": 1.0,
      "936^": 1.0
    },
    "<noise_choice>": {
      " ": 1.0,
      "\"\"": 1.0,
      "&::": 1.0,
      "REM rác": 1.0,
      "^": 1.0
    },
    "<mitre_choice>": {
      "mode con cp select=936": 1.0,
      "mode con cp select=1258": 1.0,
      "reg add \"HKCU\\Console\" /v CodePage /t REG_DWORD /d 936 /f": 1.0,
      "powershell -c \"[Console]::OutputEncoding = [System.Text.Encoding]::GetEncoding(936)\"": 1.0,
      "powershell Set-ItemProperty -Path \"HKCU:\\Console\" -Name CodePage -Value 936": 1.0,
      "nlsfunc 936": 1.0,
      "country 086,936": 1.0,
      "set LANG=zh_CN.GB2312": 1.0,
      "chcp 65001": 1.0
    }
  }
}