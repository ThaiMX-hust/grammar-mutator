{
  "rules": {
    "<start>": "<wrapper_with_payload>",
    "<wrapper_with_payload>": "<wrapper_base> <wrapper_flag> <payload>",
    "<wrapper_base>": "<wrapper_base_choice>",
    "<wrapper_flag>": "<wrapper_flag_choice>",
    "<payload>": "<obf_executable> a <noise> C:\\Temp\\archive.zip C:\\Windows\\Temp\\*<obf_extension>",
    "<noise>": "<noise_choice>"
  },
  "weights": {
    "<wrapper_base_choice>": {
      "cmd.exe": 1.0,
      "CMD.EXE": 1.0,
      "%COMSPEC%": 1.0,
      "('cmd' + '.exe')": 1.0
    },
    "<wrapper_flag_choice>": {
      "/c": 1.0,
      "/r": 1.0
    },
    "<obf_executable>": {
      "7z.exe": 1.0,
      "7Z.EXE": 1.0,
      "7z^a.exe": 1.0
    },
    "<obf_extension>": {
      ".dmp": 1.0,
      ".dump": 1.0,
      ".d^mp": 1.0
    },
    "<noise_choice>": {
      "": 1.0,
      "&::": 1.0,
      "& REM x": 1.0
    }
  }
}